    phones->addChild(std::make_shared<ProductNode>(12, "Pixel 9", true, 0.78, 4.5, 799.0));
    phones->addChild(std::make_shared<ProductNode>(13, "OnePlus 13", true, 0.65, 4.3, 699.0));
    elec->addChild(phones);

    auto laptops = std::make_shared<ProductNode>(3, "Laptops", false, 0.80);
    laptops->addChild(std::make_shared<ProductNode>(14, "MacBook Pro M4", true, 0.91, 4.9, 1999.0));
    laptops->addChild(std::make_shared<ProductNode>(15, "Dell XPS 15", true, 0.72, 4.4, 1499.0));
    laptops->addChild(std::make_shared<ProductNode>(16, "ThinkPad X1", true, 0.68, 4.3, 1299.0));
    elec->addChild(laptops);

    auto audio = std::make_shared<ProductNode>(4, "Audio", false, 0.75);
    audio->addChild(std::make_shared<ProductNode>(17, "Sony WH-1000XM6", true, 0.84, 4.7, 349.0));
    audio->addChild(std::make_shared<ProductNode>(18, "AirPods Pro 3", true, 0.89, 4.6, 279.0));
    elec->addChild(audio);

    root->addChild(elec);

    auto cloth = std::make_shared<ProductNode>(5, "Clothing", false, 0.70);

    auto shoes = std::make_shared<ProductNode>(6, "Shoes", false, 0.76);
    shoes->addChild(std::make_shared<ProductNode>(20, "Nike Air Max", true, 0.82, 4.6, 130.0));
    shoes->addChild(std::make_shared<ProductNode>(21, "Adidas Ultraboost", true, 0.79, 4.5, 180.0));
    cloth->addChild(shoes);

    auto tops = std::make_shared<ProductNode>(7, "Tops", false, 0.65);
    tops->addChild(std::make_shared<ProductNode>(22, "Levi's Denim Jacket", true, 0.61, 4.2, 89.0));
    tops->addChild(std::make_shared<ProductNode>(23, "Uniqlo Flannel", true, 0.55, 4.1, 49.0));
    cloth->addChild(tops);

    root->addChild(cloth);

    auto books = std::make_shared<ProductNode>(8, "Books", false, 0.60);
    books->addChild(std::make_shared<ProductNode>(30, "Clean Code", true, 0.77, 4.8, 35.0));
    books->addChild(std::make_shared<ProductNode>(31, "The Pragmatic Prog.", true, 0.70, 4.7, 40.0));
    books->addChild(std::make_shared<ProductNode>(32, "CLRS Algorithms", true, 0.58, 4.5, 55.0));
    root->addChild(books);

    return root;
}

int main() {
    ProductTree tree(buildSampleTree());

    tree.printTree(tree.root.get());

    auto recs = tree.recommend(2, 3);

    for (auto* p : recs) {
        std::cout << p->name << " "
                  << p->compositeScore() << "\n";
    }

    return 0;
}
