// ─────────────────────────────────────────────────────────────
//  SDG TAG — attaches goal metadata to each node / product
// ─────────────────────────────────────────────────────────────
struct SDGTag {
    int    number;      // 1-17
    std::string label;  // short name
    std::string reason; // why this node supports the goal
};

// ─────────────────────────────────────────────────────────────
//  PRODUCT NODE — core tree data structure
// ─────────────────────────────────────────────────────────────
struct ProductNode {
    int         id;
    std::string name;
    bool        is_leaf;      // true = product, false = category

    // Recommendation fields (leaf nodes)
    double popularity   = 0.0; // 0–1  click-through rate
    double rating       = 0.0; // 0–5  user review avg
    double eco_score    = 0.0; // 0–1  sustainability score    (SDG 12)
    double price        = 0.0; // USD
    double max_price    = 1000.0; // for affordability normalisation (SDG 1, 10)
    bool   fair_trade   = false;  // local/fair-trade flag      (SDG 8)
    bool   inclusive    = false;  // accessible to low-income   (SDG 10)

    // SDG annotations
    std::vector<SDGTag> sdg_tags;

    // Tree links
    ProductNode* parent = nullptr;
    std::vector<std::shared_ptr<ProductNode>> children;

    // Constructor for categories
    ProductNode(int id, std::string nm, bool leaf)
        : id(id), name(std::move(nm)), is_leaf(leaf) {}

    // Add child
    void addChild(std::shared_ptr<ProductNode> c) {
        c->parent = this;
        children.push_back(std::move(c));
    }

    // Tag this node with an SDG
    void tag(int num, const std::string& lbl, const std::string& reason) {
        sdg_tags.push_back({num, lbl, reason});
    }

    // Affordability score: cheaper = higher score (SDG 1, 10)
    double affordabilityScore() const {
        if (price <= 0 || max_price <= 0) return 0.5;
        return 1.0 - std::min(1.0, price / max_price);
    }

    // Composite SDG-aware recommendation score
    double compositeScore() const {
        double fair_bonus = fair_trade ? 0.05 : 0.0;   // SDG 8
        return 0.35 * popularity
             + 0.25 * (rating / 5.0)
             + 0.25 * eco_score                         // SDG 12
             + 0.15 * affordabilityScore()              // SDG 1, 10
             + fair_bonus;                              // SDG 8
    }

    // SDG numbers this node is tagged with
    std::string sdgList() const {
        std::string out;
        for (size_t i = 0; i < sdg_tags.size(); ++i) {
            if (i) out += ", ";
            out += "SDG " + std::to_string(sdg_tags[i].number);
        }
        return out.empty() ? "—" : out;
    }
};

// ─────────────────────────────────────────────────────────────
//  PRODUCT TREE
// ─────────────────────────────────────────────────────────────
class ProductTree {
public:
    std::shared_ptr<ProductNode> root;

    explicit ProductTree(std::shared_ptr<ProductNode> r)
        : root(std::move(r)) {}

    // Iterative DFS find — O(n)
    ProductNode* find(int target_id) const {
        if (!root) return nullptr;
        std::stack<ProductNode*> stk;
        stk.push(root.get());
        while (!stk.empty()) {
            auto* n = stk.top(); stk.pop();
            if (n->id == target_id) return n;
            for (auto& c : n->children) stk.push(c.get());
        }
        return nullptr;
    }

    // Recursive leaf collection — O(k)
    void collectLeaves(ProductNode* node,
                       std::vector<ProductNode*>& out) const {
        if (!node) return;
        if (node->is_leaf) { out.push_back(node); return; }
        for (auto& c : node->children) collectLeaves(c.get(), out);
    }

    // SDG-aware top-N recommendations — O(k log k)
    std::vector<ProductNode*> recommend(int cat_id, int top_n = 5,
                                        int sdg_filter = 0) const {
        auto* cat = find(cat_id);
        if (!cat) return {};
        std::vector<ProductNode*> leaves;
        collectLeaves(cat, leaves);

        // Optional: filter by SDG number
        if (sdg_filter > 0) {
            leaves.erase(
                std::remove_if(leaves.begin(), leaves.end(),
                    [sdg_filter](ProductNode* p) {
                        for (auto& t : p->sdg_tags)
                            if (t.number == sdg_filter) return false;
                        return true;
                    }),
                leaves.end());
        }

        std::sort(leaves.begin(), leaves.end(),
            [](ProductNode* a, ProductNode* b) {
                return a->compositeScore() > b->compositeScore();
            });

        if ((int)leaves.size() > top_n) leaves.resize(top_n);
        return leaves;
    }

    // Collect all unique SDG tags across the whole tree
    void collectSDGSummary(ProductNode* node,
                           std::map<int,std::string>& summary) const {
        if (!node) return;
        for (auto& t : node->sdg_tags)
            summary[t.number] = t.label;
        for (auto& c : node->children) collectSDGSummary(c.get(), summary);
    }

    // Pretty-print the tree
    void printTree(ProductNode* node, int depth = 0,
                   bool is_last = true,
                   const std::string& prefix = "") const {
        if (!node) return;
        std::string conn = (depth == 0) ? "" : (is_last ? "└── " : "├── ");
        std::string icon = node->is_leaf ? "🛒 " : "📁 ";
        std::cout << prefix << conn << icon << node->name;
        if (node->is_leaf) {
            std::cout << std::fixed << std::setprecision(2)
                      << "  [pop=" << node->popularity
                      << " | ★"    << node->rating
                      << " | eco=" << node->eco_score
                      << " | $"    << node->price
                      << (node->fair_trade ? " | FT✓" : "")
                      << " | " << node->sdgList() << "]";
        } else {
            if (!node->sdg_tags.empty())
                std::cout << "  [" << node->sdgList() << "]";
        }
        std::cout << "\n";
        std::string child_prefix =
            prefix + (depth == 0 ? "" : (is_last ? "    " : "│   "));
        for (size_t i = 0; i < node->children.size(); ++i)
            printTree(node->children[i].get(), depth + 1,
                      i == node->children.size() - 1, child_prefix);
    }
};

