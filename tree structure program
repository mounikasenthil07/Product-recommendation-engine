
/*
 * ============================================================
 *   PRODUCT RECOMMENDATION ENGINE — C++ Tree Data Structure
 *         Mapped to UN Sustainable Development Goals (SDGs)
 * ============================================================
 *
 *  SDG MAPPINGS:
 *  ─────────────────────────────────────────────────────────
 *  SDG  1 – No Poverty          : Recommends affordable products
 *  SDG  8 – Decent Work         : Promotes local/fair-trade items
 *  SDG  9 – Industry/Innovation : Tree-based algorithmic innovation
 *  SDG 10 – Reduced Inequalities: Inclusive pricing across categories
 *  SDG 12 – Responsible Consumption: Eco-label + sustainability score
 *  SDG 17 – Partnerships        : Open data / shared platform
 *
 *  PROBLEM STATEMENT:
 *    An inclusive e-commerce platform must recommend products
 *    that balance user preference (popularity, rating) with
 *    sustainability criteria (eco-score, fair-trade flag) and
 *    affordability — directly supporting SDG 1, 10, 12.
 *
 *  ALGORITHM:
 *    Composite Score = w1*popularity + w2*(rating/5)
 *                    + w3*eco_score  + w4*affordability_score
 *    where w1=0.35, w2=0.25, w3=0.25, w4=0.15
 *
 *  Compile: g++ -std=c++17 -o sdg_rec product_recommendation_sdg.cpp
 *  Run:     ./sdg_rec
 * ============================================================
 */

#include <iostream>
#include <string>
#include <vector>
#include <memory>
#include <stack>
#include <algorithm>
#include <iomanip>
