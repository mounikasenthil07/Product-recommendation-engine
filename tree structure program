#include <iostream>
#include <string>
#include <vector>
#include <memory>
#include <stack>
#include <algorithm>
#include <iomanip>

struct ProductNode {
    int id;
    std::string name;
    bool is_leaf;
    double popularity;
    double rating;
    double price;

    ProductNode* parent = nullptr;
    std::vector<std::shared_ptr<ProductNode>> children;

    ProductNode(int id, std::string nm, bool leaf, double pop,
                double rat = 0.0, double pr = 0.0)
        : id(id), name(std::move(nm)), is_leaf(leaf),
          popularity(pop), rating(rat), price(pr) {}

    void addChild(std::shared_ptr<ProductNode> child) {
        child->parent = this;
        children.push_back(std::move(child));
    }

    double compositeScore() const {
        return 0.6 * popularity + 0.4 * (rating / 5.0);
    }
};

class ProductTree {
public:
    std::shared_ptr<ProductNode> root;

    explicit ProductTree(std::shared_ptr<ProductNode> r)
        : root(std::move(r)) {}

    ProductNode* find(int target_id) const {
        if (!root) return nullptr;
        std::stack<ProductNode*> stk;
        stk.push(root.get());
        while (!stk.empty()) {
            auto* node = stk.top(); stk.pop();
            if (node->id == target_id) return node;
            for (auto& child : node->children)
                stk.push(child.get());
        }
        return nullptr;
    }

    void collectLeaves(ProductNode* node,
                       std::vector<ProductNode*>& out) const {
        if (!node) return;
        if (node->is_leaf) { out.push_back(node); return; }
        for (auto& c : node->children)
            collectLeaves(c.get(), out);
    }

    std::vector<ProductNode*> recommend(int cat_id, int top_n = 5) const {
        ProductNode* cat = find(cat_id);
        if (!cat) return {};

        std::vector<ProductNode*> leaves;
        collectLeaves(cat, leaves);

        std::sort(leaves.begin(), leaves.end(),
            [](ProductNode* a, ProductNode* b) {
                return a->compositeScore() > b->compositeScore();
            });

        if ((int)leaves.size() > top_n)
            leaves.resize(top_n);
        return leaves;
    }

    void printTree(ProductNode* node, int depth = 0,
                   bool is_last = true,
                   const std::string& prefix = "") const {
        if (!node) return;
        std::string connector = (depth == 0) ? "" : (is_last ? "└── " : "├── ");
        std::string icon = node->is_leaf ? "🛒 " : "📁 ";
        std::cout << prefix << connector << icon << node->name;
        if (node->is_leaf)
            std::cout << "  [pop=" << std::fixed << std::setprecision(2)
                      << node->popularity << " | ★" << node->rating
                      << " | $" << node->price << "]";
        std::cout << "\n";
        std::string child_prefix = prefix + (depth == 0 ? "" : (is_last ? "    " : "│   "));
        for (size_t i = 0; i < node->children.size(); ++i)
            printTree(node->children[i].get(), depth + 1,
                      i == node->children.size() - 1, child_prefix);
    }
};

std::shared_ptr<ProductNode> buildSampleTree() {
    auto root = std::make_shared<ProductNode>(0, "All Products", false, 1.0);

    auto elec = std::make_shared<ProductNode>(1, "Electronics", false, 0.85);

    auto phones = std::make_shared<ProductNode>(2, "Phones", false, 0.90);
