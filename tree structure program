// ─────────────────────────────────────────────────────────────
//  HELPERS
// ─────────────────────────────────────────────────────────────
void divider(char c = '=', int w = 72) {
    std::cout << std::string(w, c) << "\n";
}
void header(const std::string& s) {
    divider();
    std::cout << "  " << s << "\n";
    divider();
}

void printRecs(const ProductTree& tree, int cat_id, int top_n,
               const std::string& label, int sdg_filter = 0) {
    std::cout << "\n";
    divider('-');
    std::cout << "  Category: " << label;
    if (sdg_filter > 0) std::cout << "  [SDG " << sdg_filter << " filter]";
    std::cout << "  — top " << top_n << "\n";
    divider('-');
    std::cout << std::left
              << std::setw(4)  << "#"
              << std::setw(22) << "Product"
              << std::setw(7)  << "Score"
              << std::setw(7)  << "Pop"
              << std::setw(7)  << "★"
              << std::setw(7)  << "Eco"
              << std::setw(8)  << "Price"
              << std::setw(5)  << "FT"
              << "SDGs\n";
    divider('-');
    auto recs = tree.recommend(cat_id, top_n, sdg_filter);
    if (recs.empty()) { std::cout << "  [No results]\n"; return; }
    for (int i = 0; i < (int)recs.size(); ++i) {
        auto* p = recs[i];
        std::cout << std::left
                  << std::setw(4)  << (i+1)
                  << std::setw(22) << p->name
                  << std::fixed << std::setprecision(3)
                  << std::setw(7)  << p->compositeScore()
                  << std::setprecision(2)
                  << std::setw(7)  << p->popularity
                  << std::setw(7)  << p->rating
                  << std::setw(7)  << p->eco_score
                  << "$" << std::setw(7) << std::setprecision(0) << p->price
                  << std::setw(5)  << (p->fair_trade ? "✓" : "")
                  << p->sdgList() << "\n";
    }
}

